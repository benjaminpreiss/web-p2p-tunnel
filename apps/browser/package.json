{
  "name": "web-p2p-browser",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "node build.ts --release && npm run build:frontend",
    "build:frontend": "npm run typecheck && vite build --configLoader native && node export.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "export": "node export.ts",
    "preview": "vite preview --outDir dist/hosted-browser --configLoader native",
    "test": "node --test tests/*.test.ts",
    "test:bundle": "node --experimental-vm-modules --test smoke/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
