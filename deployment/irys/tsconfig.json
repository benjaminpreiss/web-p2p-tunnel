{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../../apps/browser/*.ts", "../../apps/browser/tests/*.ts", "../../apps/browser/smoke/*.ts", "../../apps/browser/fixtures/*.ts"]
}
